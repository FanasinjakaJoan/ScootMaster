# Scoot Master — Backend API
PORT=4000
# Chemin du fichier SQLite (dossier ./data créé automatiquement)
DB_PATH=./data/scoot.db
# Secret JWT — CHANGEZ EN PRODUCTION
JWT_SECRET=changez-moi-en-production
# Durée de vie du jeton d'accès (renouvelé silencieusement par /api/auth/refresh)
JWT_TTL=7d
# Fenêtre de grâce du refresh (jours) : un jeton périmé mais de signature valide
# reste renouvelable pendant cette durée — session conservée jusqu'à la déconnexion
JWT_REFRESH_GRACE_DAYS=30
# Origine CORS autorisée pour le preview/dév ('*' en dev)
CORS_ORIGIN=*
# Semer les données de démo au démarrage (true/false)
SEED_ON_START=true
